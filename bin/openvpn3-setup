#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$0"
SCRIPT_NAME="$(basename "$SCRIPT_PATH")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"

DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"

usage() {
  cat <<EOF
Usage:
  $SCRIPT_NAME add <ovpn-file> <profile-name>
  $SCRIPT_NAME remove <profile-name>
  $SCRIPT_NAME connect <profile-name>
  $SCRIPT_NAME disconnect <profile-name>
  $SCRIPT_NAME toggle <profile-name>
  $SCRIPT_NAME status <profile-name>
  $SCRIPT_NAME list
  $SCRIPT_NAME set-firefox-profile <profile-name> <firefox-profile-path>
  $SCRIPT_NAME clear-firefox-profile <profile-name>
  $SCRIPT_NAME help
EOF
}

error() {
  echo "$*" >&2
  exit 1
}

require_n_args() {
  local expected="$1"
  shift

  local received="$#"
  if [[ "$received" -ne "$expected" ]]; then
    usage >&2
    error "invalid number of arguments"
  fi
}

not_implemented() {
  local command="$1"

  error "not implemented: $command"
}

cmd_add() {
  require_n_args 2 "$@"

  local ovpn_file="$1"
  local profile_name="$2"

  mkdir -p "$DESKTOP_DIR"
  local desktop_file="$DESKTOP_DIR/${SCRIPT_NAME}-${profile_name}.desktop"

  cat > "$desktop_file" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=VPN $profile_name
Comment=Toggle OpenVPN for $profile_name profile
Exec="$SCRIPT_PATH" toggle "$profile_name"
Icon=network-vpn
Terminal=false
Categories=Network;
StartupNotify=false
EOF

  if openvpn3 config-manage --config "$profile_name" --show >/dev/null 2>&1; then
    error "profile already exists: $profile_name"
  fi

  openvpn3 config-import --config "$ovpn_file" --name "$profile_name"
}

cmd_remove() {
  require_n_args 1 "$@"

  local profile_name="$1"

  openvpn3 config-remove --config "$profile_name"
}

cmd_connect() {
  require_n_args 1 "$@"

  local profile_name="$1"

  if openvpn3 session-stats --config "$profile_name" >/dev/null 2>&1; then
    if openvpn3 session-auth | grep -q "Config name: $profile_name"; then
      error "profile is waiting for authentication: $profile_name"
    fi

    error "profile is already connected: $profile_name"
  fi

  openvpn3 session-start --config "$profile_name"
  notify-send -a "$SCRIPT_NAME" -i "dialog-information" "OpenVPN" "Connected to $profile_name profile."
}

cmd_disconnect() {
  require_n_args 1 "$@"

  local profile_name="$1"

  openvpn3 session-manage --disconnect --config "$profile_name"
  notify-send -a "$SCRIPT_NAME" -i "dialog-information" "OpenVPN" "Disconnected from $profile_name profile."
}

cmd_toggle() {
  require_n_args 1 "$@"

  local profile_name="$1"

  if openvpn3 session-stats --config "$profile_name" >/dev/null 2>&1; then
    cmd_disconnect "$profile_name"
  else
    cmd_connect "$profile_name"
  fi
}

cmd_status() {
  require_n_args 1 "$@"

  local profile_name="$1"

  if ! openvpn3 config-manage --config "$profile_name" --show >/dev/null 2>&1; then
    error "profile does not exist: $profile_name"
  fi

  if openvpn3 session-stats --config "$profile_name" >/dev/null 2>&1; then
    if openvpn3 session-auth | grep -q "Config name: $profile_name"; then
      echo "Waiting for authentication"
    else
      echo "Connected"
    fi
  else
    echo "Disconnected"
  fi
}

cmd_list() {
  require_n_args 0 "$@"
  not_implemented "list"
}

cmd_set_firefox_profile() {
  require_n_args 2 "$@"
  not_implemented "set-firefox-profile"
}

cmd_clear_firefox_profile() {
  require_n_args 1 "$@"
  not_implemented "clear-firefox-profile"
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    add)                   cmd_add "$@" ;;
    remove)                cmd_remove "$@" ;;
    connect)               cmd_connect "$@" ;;
    disconnect)            cmd_disconnect "$@" ;;
    toggle)                cmd_toggle "$@" ;;
    status)                cmd_status "$@" ;;
    list)                  cmd_list "$@" ;;
    set-firefox-profile)   cmd_set_firefox_profile "$@" ;;
    clear-firefox-profile) cmd_clear_firefox_profile "$@" ;;
    help|-h|--help)
      require_n_args 0 "$@"
      usage
      ;;
    *)
      usage >&2
      error "unknown command: $command"
      ;;
  esac
}

main "$@"
