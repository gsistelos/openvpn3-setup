#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$0"
SCRIPT_NAME="$(basename "$SCRIPT_PATH")"
NOTIFY=0

DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/openvpn3-setup"

FIREFOX_PROFILE_FIELD="firefox_profile"
OVPN_FILE_FIELD="ovpn_file"

usage() {
  cat <<EOF
Usage:
  $SCRIPT_NAME [--notify] <option> [arguments...]
  $SCRIPT_NAME add <ovpn-file> <profile-name>
  $SCRIPT_NAME remove <profile-name>
  $SCRIPT_NAME connect <profile-name>
  $SCRIPT_NAME disconnect <profile-name>
  $SCRIPT_NAME toggle <profile-name>
  $SCRIPT_NAME status <profile-name>
  $SCRIPT_NAME list
  $SCRIPT_NAME set-firefox-profile <profile-name> <firefox-profile-path>
  $SCRIPT_NAME clear-firefox-profile <profile-name>
  $SCRIPT_NAME help
EOF
}

# Helper functions

log() {
  local message="$*"

  if [[ "$NOTIFY" -eq 1 ]]; then
    notify-send -a "$SCRIPT_NAME" -i "dialog-information" "OpenVPN" "$message"
  else
    printf '%s\n' "$message"
  fi
}

error() {
  local message="$*"

  if [[ "$NOTIFY" -eq 1 ]]; then
    notify-send -a "$SCRIPT_NAME" -i "dialog-error" "OpenVPN" "$message"
  else
    printf '%s\n' "$message" >&2
  fi

  exit 1
}

not_implemented() {
  local command="$1"
  error "not implemented: $command"
}

require_n_args() {
  local expected="$1"
  shift

  local received="$#"
  if [[ "$received" -ne "$expected" ]]; then
    usage >&2
    error "invalid number of arguments"
  fi
}

# Config management functions
# Config is: openvpn3 managed config

config_exists() {
  local config_name="$1"

  if openvpn3 config-manage --config "$config_name" --show >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

add_config() {
  local ovpn_file="$1"
  local config_name="$2"

  # openvpn3 accepts multiple configs with the same name
  if config_exists "$config_name"; then
    error "config \"$config_name\" already exists"
  fi

  openvpn3 config-import --config "$ovpn_file" --name "$config_name"
}

remove_config() {
  local config_name="$1"

  # openvpn3 allows configs to be removed even if there are sessions using them
  if session_exists "$config_name"; then
    error "session for config \"$config_name\" is still active"
  fi

  openvpn3 config-remove --config "$config_name"
}

# Session management functions
# Session is: openvpn3 session

session_exists() {
  local session_name="$1"

  if openvpn3 session-stats --config "$session_name" >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

session_is_waiting_for_authentication() {
  local session_name="$1"

  if { openvpn3 session-auth 2>/dev/null || true; } | grep -q "Config name: $session_name"; then
    return 0
  fi

  return 1
}

get_session_auth_url() {
  local session_name="$1"

  { openvpn3 session-auth 2>/dev/null || true; } | awk -v session_name="$session_name" '
    /^-+$/ { in_profile = 0 }
    $0 == (" Config name: " session_name) { in_profile = 1 }
    in_profile && /Auth URL:/ {
      sub(/.*Auth URL:[ ]*/, "")
      print
      exit
    }
  '
}

# Desktop file management functions
# Desktop files are: openvpn3-setup desktop launcher files

get_desktop_file() {
  local profile_name="$1"
  printf '%s\n' "$DESKTOP_DIR/openvpn3-setup-${profile_name}.desktop"
}

ensure_desktop_file_exists() {
  local profile_name="$1"
  local desktop_file
  
  desktop_file="$(get_desktop_file "$profile_name")"

  if [[ ! -f "$desktop_file" ]]; then
    mkdir -p "$DESKTOP_DIR"

    cat > "$desktop_file" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=VPN $profile_name
Comment=Toggle OpenVPN for $profile_name profile
Exec="$SCRIPT_PATH" --notify toggle "$profile_name"
Icon=network-vpn
Terminal=false
Categories=Network;
StartupNotify=false
EOF
  fi

  printf '%s\n' "$desktop_file"
}

# JSON file management functions
# JSON files are: openvpn3-setup state files

get_json_file() {
  local profile_name="$1"
  printf '%s\n' "$CONFIG_DIR/${profile_name}.json"
}

ensure_json_file_exists() {
  local profile_name="$1"
  local json_file
  
  json_file="$(get_json_file "$profile_name")"

  if [[ ! -f "$json_file" ]]; then
    mkdir -p "$CONFIG_DIR"

    cat > "$json_file" <<EOF
{
    "$FIREFOX_PROFILE_FIELD": null,
    "$OVPN_FILE_FIELD": null
}
EOF
  fi

  printf '%s\n' "$json_file"
}

get_json_field() {
  local profile_name="$1"
  local field_name="$2"
  local json_file

  json_file="$(ensure_json_file_exists "$profile_name")"
  jq -r ".$field_name" "$json_file"
}

set_json_field() {
  local profile_name="$1"
  local field_name="$2"
  local field_value="$3"
  local json_file
  local tmp_file

  json_file="$(ensure_json_file_exists "$profile_name")"
  tmp_file="$(mktemp)"

  if [[ "$field_value" == "null" ]]; then
    jq --arg field_name "$field_name" '.[$field_name] = null' "$json_file" > "$tmp_file"
  else
    jq --arg field_name "$field_name" --arg field_value "$field_value" '.[$field_name] = $field_value' "$json_file" > "$tmp_file"
  fi

  mv "$tmp_file" "$json_file"
}

# Profile management functions
# Profile is: openvpn3-setup managed profile

profile_exists() {
  local profile_name="$1"
  [[ -f "$(get_json_file "$profile_name")" && -f "$(get_desktop_file "$profile_name")" ]]
}

error_if_profile_not_exists() {
  local profile_name="$1"

  if ! profile_exists "$profile_name"; then
    if config_exists "$profile_name"; then
      error "profile \"$profile_name\" is not managed by openvpn3-setup"
    fi
    error "profile \"$profile_name\" does not exist"
  fi
}

# cmd_add auxiliary functions

wait_for_connected_or_auth() {
  local profile_name="$1"
  local attempt

  for attempt in {1..5}; do
    sleep 3

    if session_is_waiting_for_authentication "$profile_name"; then
      printf '%s\n' "waiting_for_authentication"
      return 0
    fi

    if session_exists "$profile_name"; then
      printf '%s\n' "connected"
      return 0
    fi
  done

  printf '%s\n' "starting"
}

connect_with_firefox_profile() {
  local profile_name="$1"
  local firefox_profile="$2"
  local session_state

  openvpn3 session-start --background --config "$profile_name"

  session_state="$(wait_for_connected_or_auth "$profile_name")"

  if [[ "$session_state" == "connected" ]]; then
    log "Connected to \"$profile_name\" profile."
    return
  fi

  if [[ "$session_state" == "waiting_for_authentication" ]]; then
    local auth_url
    auth_url="$(get_session_auth_url "$profile_name")"
    if [[ -n "$auth_url" ]]; then
      log "Opening authentication URL in Firefox for \"$profile_name\" profile..."
      MOZ_DBUS_REMOTE=0 firefox --no-remote --profile "$firefox_profile" "$auth_url"
    else
      log "Could not find authentication URL for \"$profile_name\" profile."
      openvpn3 session-manage --disconnect --config "$profile_name"
    fi
    return
  fi

  log "Connection for \"$profile_name\" is still starting. Run \"$SCRIPT_NAME status $profile_name\"."
}

# Command handlers

cmd_add() {
  require_n_args 2 "$@"

  local ovpn_file="$1"
  local profile_name="$2"

  if profile_exists "$profile_name"; then
    error "profile \"$profile_name\" already exists"
  fi

  add_config "$ovpn_file" "$profile_name"

  ensure_desktop_file_exists "$profile_name"
  set_json_field "$profile_name" "$OVPN_FILE_FIELD" "$ovpn_file"
}

cmd_remove() {
  require_n_args 1 "$@"

  local profile_name="$1"

  rm -f "$(get_desktop_file "$profile_name")"
  rm -f "$(get_json_file "$profile_name")"

  remove_config "$profile_name"
}

cmd_connect() {
  require_n_args 1 "$@"

  local profile_name="$1"

  error_if_profile_not_exists "$profile_name"

  if ! config_exists "$profile_name"; then
    local ovpn_file
    ovpn_file="$(get_json_field "$profile_name" "$OVPN_FILE_FIELD")"
    add_config "$ovpn_file" "$profile_name"
  fi

  if session_exists "$profile_name"; then
    if session_is_waiting_for_authentication "$profile_name"; then
      local auth_url
      auth_url="$(get_session_auth_url "$profile_name")"
      if [[ -n "$auth_url" ]]; then
        error "profile \"$profile_name\" is waiting for authentication, open the following URL in your browser: $auth_url"
      fi
      error "profile \"$profile_name\" is waiting for authentication, could not find authentication URL"
    fi
    error "profile \"$profile_name\" is already connected"
  fi

  local firefox_profile
  firefox_profile="$(get_json_field "$profile_name" "$FIREFOX_PROFILE_FIELD")"
  if [[ -n "$firefox_profile" ]]; then
    connect_with_firefox_profile "$profile_name" "$firefox_profile"
    return
  fi

  openvpn3 session-start --config "$profile_name"
  log "Connected to \"$profile_name\" profile."
}

cmd_disconnect() {
  require_n_args 1 "$@"

  local profile_name="$1"

  error_if_profile_not_exists "$profile_name"

  openvpn3 session-manage --disconnect --config "$profile_name"
  log "Disconnected from \"$profile_name\" profile."
}

cmd_toggle() {
  require_n_args 1 "$@"

  local profile_name="$1"

  if session_exists "$profile_name"; then
    cmd_disconnect "$profile_name"
  else
    cmd_connect "$profile_name"
  fi
}

cmd_status() {
  require_n_args 1 "$@"

  local profile_name="$1"

  error_if_profile_not_exists "$profile_name"

  if ! session_exists "$profile_name"; then
    log "profile \"$profile_name\" is disconnected"
    return
  fi

  if session_is_waiting_for_authentication "$profile_name"; then
    local auth_url
    auth_url="$(get_session_auth_url "$profile_name")"
    if [[ -n "$auth_url" ]]; then
      log "profile \"$profile_name\" is waiting for authentication, open the following URL in your browser: $auth_url"
    else
      log "profile \"$profile_name\" is waiting for authentication, could not find authentication URL"
    fi
    return
  fi

  log "profile \"$profile_name\" is connected"
}

cmd_list() {
  require_n_args 0 "$@"
  not_implemented "list"
}

cmd_set_firefox_profile() {
  require_n_args 2 "$@"

  local profile_name="$1"
  local firefox_profile_path="$2"

  error_if_profile_not_exists "$profile_name"

  if [[ ! -d "$firefox_profile_path" ]]; then
    error "firefox profile path \"$firefox_profile_path\" does not exist or is not a directory"
  fi

  set_json_field "$profile_name" "$FIREFOX_PROFILE_FIELD" "$firefox_profile_path"
}

cmd_clear_firefox_profile() {
  require_n_args 1 "$@"

  local profile_name="$1"

  error_if_profile_not_exists "$profile_name"

  set_json_field "$profile_name" "$FIREFOX_PROFILE_FIELD" null
}

main() {
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --notify)
        NOTIFY=1
        shift
        ;;
      --help)
        usage
        return 0
        ;;
      *)
        usage >&2
        error "unknown option: $1"
        ;;
    esac
  done

  local command="${1:-help}"
  shift || true

  case "$command" in
    add)                   cmd_add "$@" ;;
    remove)                cmd_remove "$@" ;;
    connect)               cmd_connect "$@" ;;
    disconnect)            cmd_disconnect "$@" ;;
    toggle)                cmd_toggle "$@" ;;
    status)                cmd_status "$@" ;;
    list)                  cmd_list "$@" ;;
    set-firefox-profile)   cmd_set_firefox_profile "$@" ;;
    clear-firefox-profile) cmd_clear_firefox_profile "$@" ;;
    help|-h|--help)
      require_n_args 0 "$@"
      usage
      ;;
    *)
      usage >&2
      error "unknown command: $command"
      ;;
  esac
}

main "$@"
