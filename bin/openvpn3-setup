#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$0"
SCRIPT_NAME="$(basename "$SCRIPT_PATH")"
NOTIFY=0

DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$SCRIPT_NAME"

usage() {
  cat <<EOF
Usage:
  $SCRIPT_NAME [--notify] add <ovpn-file> <profile-name>
  $SCRIPT_NAME [--notify] remove <profile-name>
  $SCRIPT_NAME [--notify] connect <profile-name>
  $SCRIPT_NAME [--notify] disconnect <profile-name>
  $SCRIPT_NAME [--notify] toggle <profile-name>
  $SCRIPT_NAME [--notify] status <profile-name>
  $SCRIPT_NAME [--notify] list
  $SCRIPT_NAME [--notify] set-firefox-profile <profile-name> <firefox-profile-path>
  $SCRIPT_NAME [--notify] clear-firefox-profile <profile-name>
  $SCRIPT_NAME [--notify] help
EOF
}

# Helper functions

log() {
  local message="$*"

  if [[ "$NOTIFY" -eq 1 ]]; then
    notify-send -a "$SCRIPT_NAME" -i "dialog-information" "OpenVPN" "$message"
    return
  fi

  printf '%s\n' "$message"
}

error() {
  local message="$*"

  if [[ "$NOTIFY" -eq 1 ]]; then
    notify-send -a "$SCRIPT_NAME" -i "dialog-error" "OpenVPN" "$message"
  else
    printf '%s\n' "$message" >&2
  fi

  exit 1
}

require_n_args() {
  local expected="$1"
  shift

  local received="$#"
  if [[ "$received" -ne "$expected" ]]; then
    usage >&2
    error "invalid number of arguments"
  fi
}

get_desktop_file() {
  local profile_name="$1"

  printf '%s\n' "$DESKTOP_DIR/${SCRIPT_NAME}-${profile_name}.desktop"
}

profile_exists() {
  local profile_name="$1"

  if openvpn3 config-manage --config "$profile_name" --show >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

profile_is_connected() {
  local profile_name="$1"

  if openvpn3 session-stats --config "$profile_name" >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

profile_is_waiting_for_authentication() {
  local profile_name="$1"

  if openvpn3 session-auth | grep -q "Config name: $profile_name"; then
    return 0
  fi

  return 1
}

get_auth_url() {
  local profile_name="$1"

  openvpn3 session-auth 2>/dev/null | awk -v profile_name="$profile_name" '
    $0 == "Config name: " profile_name {
      in_profile = 1
      next
    }
    /^Config name: / && in_profile {
      in_profile = 0
    }
    in_profile && match($0, /https:\/\/[^ ]+/) {
      print substr($0, RSTART, RLENGTH)
      exit
    }
  '
}

get_config_file() {
  local profile_name="$1"
  printf '%s\n' "$CONFIG_DIR/${profile_name}.conf"
}

get_config_field() {
  local profile_name="$1"
  local field_name="$2"
  local config_file

  config_file="$(get_config_file "$profile_name")"

  if [[ ! -f "$config_file" ]]; then
    return 0
  fi

  awk -v field_name="$field_name" -F= '
    $1 == field_name {
      print substr($0, length(field_name) + 2)
      exit
    }
  ' "$config_file"
}

set_config_field() {
  local profile_name="$1"
  local field_name="$2"
  local field_value="$3"
  local config_file
  local temp_file

  config_file="$(get_config_file "$profile_name")"
  temp_file="$(mktemp)"

  mkdir -p "$CONFIG_DIR"

  if [[ -f "$config_file" ]]; then
    awk -v field_name="$field_name" -v field_value="$field_value" '
      BEGIN {
        updated = 0
      }
      index($0, field_name "=") == 1 {
        if (!updated) {
          print field_name "=" field_value
          updated = 1
        }
        next
      }
      {
        print
      }
      END {
        if (!updated) {
          print field_name "=" field_value
        }
      }
    ' "$config_file" > "$temp_file"
  else
    printf '%s=%s\n' "$field_name" "$field_value" > "$temp_file"
  fi

  mv "$temp_file" "$config_file"
}

clear_config_field() {
  local profile_name="$1"
  local field_name="$2"
  local config_file
  local temp_file

  config_file="$(get_config_file "$profile_name")"

  if [[ ! -f "$config_file" ]]; then
    return 0
  fi

  temp_file="$(mktemp)"

  awk -v field_name="$field_name" '
    index($0, field_name "=") != 1 {
      print
    }
  ' "$config_file" > "$temp_file"

  if [[ -s "$temp_file" ]]; then
    mv "$temp_file" "$config_file"
  else
    rm -f "$config_file" "$temp_file"
  fi
}

get_firefox_profile() {
  local profile_name="$1"
  get_config_field "$profile_name" "firefox_profile"
}

wait_for_connected_or_auth() {
  local profile_name="$1"
  local attempt

  for attempt in {1..20}; do
    sleep 0.25

    if profile_is_waiting_for_authentication "$profile_name"; then
      printf '%s\n' "waiting_for_authentication"
      return 0
    fi

    if profile_is_connected "$profile_name"; then
      printf '%s\n' "connected"
      return 0
    fi
  done

  printf '%s\n' "starting"
}

connect_with_firefox_profile() {
  local profile_name="$1"
  local firefox_profile="$2"
  local session_state
  local auth_url

  openvpn3 session-start --background --config "$profile_name"

  session_state="$(wait_for_connected_or_auth "$profile_name")"

  if [[ "$session_state" == "connected" ]]; then
    notify-send -a "$SCRIPT_NAME" -i "dialog-information" "OpenVPN" "Connected to \"$profile_name\" profile."
    return
  fi

  if [[ "$session_state" == "waiting_for_authentication" ]]; then
    auth_url="$(get_auth_url "$profile_name" || true)"
    if [[ -n "$auth_url" ]]; then
      MOZ_DBUS_REMOTE=0 firefox --no-remote --profile "$firefox_profile" "$auth_url"
      notify-send -a "$SCRIPT_NAME" -i "dialog-information" "OpenVPN" "Opening authentication URL in Firefox for \"$profile_name\" profile..."
    else
      notify-send -a "$SCRIPT_NAME" -i "dialog-warning" "OpenVPN" "Could not find authentication URL for \"$profile_name\" profile."
      openvpn3 session-manage --disconnect --config "$profile_name"
    fi
    return
  fi

  notify-send -a "$SCRIPT_NAME" -i "dialog-warning" "OpenVPN" "Connection for \"$profile_name\" is still starting. Run \"$SCRIPT_NAME status $profile_name\"."
}

not_implemented() {
  local command="$1"

  error "not implemented: $command"
}

# Command handlers

cmd_add() {
  require_n_args 2 "$@"

  local ovpn_file="$1"
  local profile_name="$2"

  mkdir -p "$DESKTOP_DIR"

  cat > "$(get_desktop_file "$profile_name")" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=VPN $profile_name
Comment=Toggle OpenVPN for $profile_name profile
Exec="$SCRIPT_PATH" --notify toggle "$profile_name"
Icon=network-vpn
Terminal=false
Categories=Network;
StartupNotify=false
EOF

  if profile_exists "$profile_name"; then
    error "profile \"$profile_name\" already exists"
  fi

  openvpn3 config-import --config "$ovpn_file" --name "$profile_name"
}

cmd_remove() {
  require_n_args 1 "$@"

  local profile_name="$1"

  rm -f "$(get_desktop_file "$profile_name")"

  openvpn3 config-remove --config "$profile_name"
}

cmd_connect() {
  require_n_args 1 "$@"

  local profile_name="$1"
  local auth_url
  local firefox_profile

  if ! profile_exists "$profile_name"; then
    error "profile \"$profile_name\" does not exist"
  fi

  if profile_is_connected "$profile_name"; then
    if profile_is_waiting_for_authentication "$profile_name"; then
      auth_url="$(get_auth_url "$profile_name" || true)"
      if [[ -n "$auth_url" ]]; then
        error "profile \"$profile_name\" is waiting for authentication, open the following URL in your browser: $auth_url"
      fi

      error "profile \"$profile_name\" is waiting for authentication, could not find authentication URL"
    fi

    error "profile \"$profile_name\" is already connected"
  fi

  firefox_profile="$(get_firefox_profile "$profile_name" || true)"
  if [[ ! -n "$firefox_profile" ]]; then
    openvpn3 session-start --config "$profile_name"
    notify-send -a "$SCRIPT_NAME" -i "dialog-information" "OpenVPN" "Connected to \"$profile_name\" profile."
    return
  fi

  connect_with_firefox_profile "$profile_name" "$firefox_profile"
}

cmd_disconnect() {
  require_n_args 1 "$@"

  local profile_name="$1"

  openvpn3 session-manage --disconnect --config "$profile_name"
  notify-send -a "$SCRIPT_NAME" -i "dialog-information" "OpenVPN" "Disconnected from \"$profile_name\" profile."
}

cmd_toggle() {
  require_n_args 1 "$@"

  local profile_name="$1"

  if profile_is_connected "$profile_name"; then
    cmd_disconnect "$profile_name"
  else
    cmd_connect "$profile_name"
  fi
}

cmd_status() {
  require_n_args 1 "$@"

  local profile_name="$1"
  local auth_url

  if ! profile_exists "$profile_name"; then
    error "profile \"$profile_name\" does not exist"
  fi

  if profile_is_connected "$profile_name"; then
    if profile_is_waiting_for_authentication "$profile_name"; then
      auth_url="$(get_auth_url "$profile_name" || true)"
      if [[ -n "$auth_url" ]]; then
        log "profile \"$profile_name\" is waiting for authentication, open the following URL in your browser: $auth_url"
      else
        log "profile \"$profile_name\" is waiting for authentication, could not find authentication URL"
      fi
    else
      log "profile \"$profile_name\" is connected"
    fi
  else
    log "profile \"$profile_name\" is disconnected"
  fi
}

cmd_list() {
  require_n_args 0 "$@"
  not_implemented "list"
}

cmd_set_firefox_profile() {
  require_n_args 2 "$@"

  local profile_name="$1"
  local firefox_profile_path="$2"

  if ! profile_exists "$profile_name"; then
    error "profile \"$profile_name\" does not exist"
  fi

  if [[ ! -d "$firefox_profile_path" ]]; then
    error "firefox profile path \"$firefox_profile_path\" does not exist or is not a directory"
  fi

  set_config_field "$profile_name" "firefox_profile" "$firefox_profile_path"
}

cmd_clear_firefox_profile() {
  require_n_args 1 "$@"

  local profile_name="$1"

  if ! profile_exists "$profile_name"; then
    error "profile \"$profile_name\" does not exist"
  fi

  clear_config_field "$profile_name" "firefox_profile"
}

main() {
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --notify)
        NOTIFY=1
        shift
        ;;
      --help)
        usage
        return 0
        ;;
      *)
        usage >&2
        error "unknown option: $1"
        ;;
    esac
  done

  local command="${1:-help}"
  shift || true

  case "$command" in
    add)                   cmd_add "$@" ;;
    remove)                cmd_remove "$@" ;;
    connect)               cmd_connect "$@" ;;
    disconnect)            cmd_disconnect "$@" ;;
    toggle)                cmd_toggle "$@" ;;
    status)                cmd_status "$@" ;;
    list)                  cmd_list "$@" ;;
    set-firefox-profile)   cmd_set_firefox_profile "$@" ;;
    clear-firefox-profile) cmd_clear_firefox_profile "$@" ;;
    help|-h|--help)
      require_n_args 0 "$@"
      usage
      ;;
    *)
      usage >&2
      error "unknown command: $command"
      ;;
  esac
}

main "$@"
